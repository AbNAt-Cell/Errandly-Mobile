# Render + Vercel — copy secrets into dashboards (do not commit real values).
#
# After first successful API deploy:
#   1. Copy the Render web service URL → APP_URL and Vercel NEXT_PUBLIC_API_URL
#   2. Set FRONTEND_URL to your Vercel URL (https://….vercel.app or custom domain)
#   3. Set RUN_MIGRATIONS=false for subsequent deploys

# --- Render: errandlyapp-api (set in Dashboard → Environment) ---
APP_URL=https://errandlyapp-api.onrender.com
FRONTEND_URL=https://your-app.vercel.app
# APP_KEY / JWT_SECRET / DATABASE_URL / REDIS_URL are usually auto-injected by Blueprint

# Optional integrations
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
BROADCAST_DRIVER=log

# After first migrate+boot:
# RUN_MIGRATIONS=false

# --- Vercel: errandly/web ---
NEXT_PUBLIC_API_URL=https://errandlyapp-api.onrender.com/api
NEXT_PUBLIC_APP_NAME=Errandly
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=mt1
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
