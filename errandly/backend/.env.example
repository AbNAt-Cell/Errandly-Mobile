APP_NAME=Errandly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lagos

FRONTEND_URL=http://localhost:3000
MOBILE_DEEP_LINK_URL=errandly://

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=errandly
DB_USERNAME=postgres
DB_PASSWORD=secret

BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@errandly.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# ─────────────────────────────────────────────────────────────────────────────
# Payment Gateways
# ─────────────────────────────────────────────────────────────────────────────

# Paystack (primary — card, bank transfer, USSD, payouts to NGN accounts)
# Dashboard: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Flutterwave (secondary — additional payment channels, alternate payout)
# Dashboard: https://dashboard.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret

# Stripe (international cards only)
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# SMS / OTP
# ─────────────────────────────────────────────────────────────────────────────

# Termii (Nigerian SMS gateway — preferred)
# Dashboard: https://app.termii.com/account/api
TERMII_API_KEY=
TERMII_SENDER_ID=Errandly

# Twilio (fallback SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# Third-Party Services
# ─────────────────────────────────────────────────────────────────────────────

GOOGLE_MAPS_API_KEY=

# Firebase (push notifications)
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json
FIREBASE_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Platform Business Rules
# ─────────────────────────────────────────────────────────────────────────────

PLATFORM_COMMISSION_RATE=0.15
PLATFORM_MIN_ERRAND_AMOUNT=500
PLATFORM_CURRENCY=NGN

# ─────────────────────────────────────────────────────────────────────────────
# Developer Tools
# ─────────────────────────────────────────────────────────────────────────────

TELESCOPE_ENABLED=true
HORIZON_ENABLED=true
