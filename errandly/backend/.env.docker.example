# Copy to .env before: docker compose up
#   cp .env.docker.example .env

APP_NAME=Errandly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lagos

FRONTEND_URL=http://localhost:3000
MOBILE_DEEP_LINK_URL=errandly://

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Docker Compose Postgres service
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=errandly
DB_USERNAME=errandly
DB_PASSWORD=errandly
DB_SSLMODE=prefer

# Or external Postgres (Prisma / Supabase) — comment DB_* above and set:
# DATABASE_URL=postgres://USER:PASS@host:5432/db?sslmode=require

BROADCAST_DRIVER=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

TELESCOPE_ENABLED=false
HORIZON_ENABLED=false

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Container bootstrap (docker-compose.yml)
RUN_MIGRATIONS=true
RUN_SEEDERS=true
WAIT_FOR_DB=true
CACHE_CONFIG=false
