# errandlyapp — copy into Dokploy → Compose service "errandlyapp" → Environment
# (do not commit secrets). First deploy: RUN_MIGRATIONS=true once, then set false.

# --- App ---
APP_NAME=Errandly
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
APP_TIMEZONE=Africa/Lagos

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# --- Database (recommended: Dokploy Postgres or Prisma) ---
# Use the internal Docker hostname Dokploy shows for the DB service, NOT localhost.
# DATABASE_URL=postgres://USER:PASS@dokploy-postgres:5432/errandly?sslmode=require
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=errandly
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# If using Compose profile local-db instead:
# DB_HOST=postgres
# DB_SSLMODE=prefer

# --- Redis (compose service name) ---
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
FILESYSTEM_DISK=s3

# --- Bootstrap ---
WAIT_FOR_DB=true
RUN_MIGRATIONS=false
RUN_SEEDERS=false
CACHE_CONFIG=true
TELESCOPE_ENABLED=false

# --- Web (baked at image build — set before first web build / rebuild after change) ---
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=mt1
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_APP_NAME=Errandly

# --- Integrations (fill for production) ---
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# FIREBASE_ENABLED=true
# + mount/credentials as documented in backend README
