# =============================================================================
# Errandly app package — ignore build artifacts, deps, and secrets
# Lives next to: backend/  web/  mobile/  docs/
# =============================================================================

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- IDEs & editors ---
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.fleet/
*.sublime-workspace

# --- Environment & secrets (keep examples) ---
.env
.env.*
!.env.example
!.env.docker.example
!.env.dokploy.example
**/.env
**/.env.*
!**/.env.example
!**/.env.docker.example
!**/.env.dokploy.example
!**/*.example
auth.json
*.pem
*.p12
*.key
!**/public/**/*.key

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Dependencies ---
node_modules/
vendor/
.pnp
.pnp.js

# --- Generic build / cache ---
dist/
build/
out/
tmp/
temp/
.cache/
coverage/
*.tsbuildinfo

# =============================================================================
# Backend (Laravel)
# =============================================================================
backend/vendor/
backend/vendor.zip
backend/node_modules/
backend/.env
backend/.env.backup
backend/.env.production
backend/auth.json
backend/.phpunit.result.cache
backend/.phpunit.cache
backend/bootstrap/cache/*.php
backend/bootstrap/bootstrap/
backend/storage/*.key
backend/storage/pail
backend/storage/app/firebase-credentials.json
backend/storage/app/*.key
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/public/storage
backend/public/hot
backend/public/build
backend/public/phpinfo.php
backend/public/publicinfo.php
backend/Homestead.json
backend/Homestead.yaml

# =============================================================================
# Web (Next.js)
# =============================================================================
web/node_modules/
web/.next/
web/out/
web/build/
web/dist/
web/.vercel
web/.env
web/.env*.local
web/next-env.d.ts
web/npm-debug.log*
web/yarn-error.log*
web/pnpm-debug.log*

