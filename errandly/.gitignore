# =============================================================================
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/coverage/
mobile/**/doc/api/
mobile/**/*.iml
mobile/.idea/
mobile/app.*.symbols
mobile/app.*.map.json

# Firebase configs (add locally; never commit)
mobile/**/google-services.json
mobile/**/GoogleService-Info.plist

# Android signing & local SDK
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/captures/
mobile/android/.cxx/
mobile/android/**/cxx/
mobile/android/**/GeneratedPluginRegistrant.java
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/android/key.properties
mobile/android/*.jks
mobile/android/*.keystore
mobile/android/upload-keystore.jks

# iOS
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
