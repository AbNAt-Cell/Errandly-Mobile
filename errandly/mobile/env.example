# =============================================================================
# Errandly Mobile — production setup checklist
# Copy values into the locations below. This file is documentation only.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PLAY STORE RELEASE SIGNING (required for production AAB)
# -----------------------------------------------------------------------------
# Generate upload keystore (run once, store the .jks file safely — loss = cannot update app):
#
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Copy android/key.properties.example → android/key.properties and fill in:
#
#   storePassword=
#   keyPassword=
#   keyAlias=upload
#   storeFile=../upload-keystore.jks
#
# Build release bundle:
#
#   flutter build appbundle --release
#
# Output: build/app/outputs/bundle/release/app-release.aab

# -----------------------------------------------------------------------------
# 2. FIREBASE / PUSH NOTIFICATIONS (required if you declare push in Play Console)
# -----------------------------------------------------------------------------
# 1. Go to https://console.firebase.google.com
# 2. Create or open project (same as backend FIREBASE_PROJECT_ID)
# 3. Project settings → Your apps → Add Android app
# 4. Package name: com.example.errandly  (must match android/app/build.gradle.kts)
# 5. Download google-services.json → place at:
#
#      android/app/google-services.json
#
# 6. Backend .env must have:
#      FIREBASE_ENABLED=true
#      FIREBASE_PROJECT_ID=your-project-id
#      FIREBASE_CREDENTIALS=/path/to/service-account.json
#
# 7. Test: php artisan fcm:test customer@test.com (on backend server)

# -----------------------------------------------------------------------------
# 3. LEGAL URLs (required for Play Console + in-app links)
# -----------------------------------------------------------------------------
# Host these pages on your public website, then set in lib/core/constants/app_constants.dart:
#
#   privacyPolicyUrl   = https://errandly.wealthnation.ng/privacy
#   termsOfServiceUrl  = https://errandly.wealthnation.ng/terms
#   supportEmail       = support@wealthnation.ng
#   supportUrl         = https://errandly.wealthnation.ng/support
#
# Play Console → App content → Privacy policy → paste privacyPolicyUrl

# -----------------------------------------------------------------------------
# 4. API BASE URL (production)
# -----------------------------------------------------------------------------
# Set in lib/core/constants/app_constants.dart:
#
#   baseUrl = https://errandly.wealthnation.ng/api
#
# Must match a live backend with valid SSL certificate.

# -----------------------------------------------------------------------------
# 5. PUSHER REALTIME (optional — leave empty to use polling)
# -----------------------------------------------------------------------------
# If enabling live tracking updates:
#   pusherKey     = your-pusher-key
#   pusherCluster = mt1
# Get keys: https://dashboard.pusher.com → Channels → App keys

# -----------------------------------------------------------------------------
# 6. GOOGLE PLAY CONSOLE (not in repo — complete manually)
# -----------------------------------------------------------------------------
# - Developer account: https://play.google.com/console ($25 one-time)
# - Store listing: title, short/full description, 2+ phone screenshots, feature graphic 1024×500
# - Data safety form: personal info, financial data (wallet), device IDs (FCM if enabled)
# - Content rating (IARC questionnaire)
# - Target audience
# - App category: Business or Lifestyle
# - Upload app-release.aab to Production or Internal testing

# -----------------------------------------------------------------------------
# 7. ACCOUNT DELETION (backend + app)
# -----------------------------------------------------------------------------
# Mobile calls DELETE /api/auth/account with password confirmation.
# Ensure backend is deployed with this endpoint before publishing.
